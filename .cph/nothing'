def calculate_bmi(weight, height):
    return weight / (height * height)

def show_result(bmi):
    print("\nYour BMI:", round(bmi, 2))

    if bmi < 18.5:
        print("Category: Underweight")
        print("Tip: Maintain a balanced, nutritious diet.")
    elif bmi < 25:
        print("Category: Normal")
        print("Tip: Maintain your healthy lifestyle.")
    elif bmi < 30:
        print("Category: Overweight")
        print("Tip: Focus on balanced meals and regular exercise.")
    else:
        print("Category: Obesity")
        print("Tip: Consider consulting a healthcare professional.")
        
def register():
    username = input("Create username: ")

    with open("bodywise.txt", "a+") as file:
        file.seek(0)
        for line in file:
            if line.split("|")[0] == username:
                print("Username already exists!")
                return

    age = int(input("Enter age: "))
    gender = input("Enter gender: ")
    height = float(input("Enter height in metres: "))
    weight = float(input("Enter weight in kg: "))

    bmi = calculate_bmi(weight, height)

    with open("bodywise.txt", "a") as file:
        file.write(f"{username}|{age}|{gender}|{height}|{weight}\n")

    print("\nRegistration successful!")
    show_result(bmi)
    print("Healthy weight range:",
          round(18.5 * height ** 2, 1), "to",
          round(24.9 * height ** 2, 1), "kg")

    print("Note: BMI is a screening guide, not a medical diagnosis.")


def login():
    username = input("Enter username: ")
    records = []

    try:
        with open("bodywise.txt", "r") as file:
            for line in file:
                data = line.strip().split("|")
                if data[0] == username:
                    records.append(data)
    except FileNotFoundError:
        print("No registered users found!")
        return

    if not records:
        print("User not found!")
        return

    age = int(records[-1][1])
    height = float(records[-1][3])
    old_weight = float(records[-1][4])

    print("\nWelcome back,", username)
    new_weight = float(input("Enter your current weight: "))

    bmi = calculate_bmi(new_weight, height)

    with open("bodywise.txt", "a") as file:
        file.write(f"{username}|{age}|{records[-1][2]}|{height}|{new_weight}\n")

    show_result(bmi)

    difference = new_weight - old_weight

    if difference > 0:
        print("Weight gained:", round(difference, 2), "kg")
    elif difference < 0:
        print("Weight lost:", round(abs(difference), 2), "kg")
    else:
        print("Your weight remains unchanged.")

    print("\nBMI History:")
    for record in records:
        print("Weight:", record[4], "kg")

    print("Current healthy weight range:",
          round(18.5 * height ** 2, 1), "to",
          round(24.9 * height ** 2, 1), "kg")


while True:
    print("\n===== BODYWISE =====")
    print("1. Register New User")
    print("2. Login and Update Weight")
    print("3. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        register()
    elif choice == "2":
        login()
    elif choice == "3":
        print("Thank you for using BODYWISE!")
        break
    else:
        print("Invalid choice! Try again.")
        